APP_NAME="Court Hub API"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.staging.example.com

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=replace-with-staging-db-host
DB_PORT=3306
DB_DATABASE=court_hub_staging
DB_USERNAME=replace-with-staging-db-user
DB_PASSWORD=replace-with-staging-db-password

SESSION_DRIVER=database
SESSION_ENCRYPT=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=s3

REDIS_HOST=replace-with-staging-redis-host
REDIS_PASSWORD=replace-with-staging-redis-password
REDIS_PORT=6379

# The Xendit test double is intentionally disabled outside local/testing.
XENDIT_MOCK_ENABLED=false
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_RETURN_URL=https://staging.example.com/payments/return

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=/secure/court-hub/fcm-service-account.json

MAIL_MAILER=smtp
MAIL_HOST=replace-with-staging-smtp-host
MAIL_PORT=587
MAIL_USERNAME=replace-with-staging-smtp-user
MAIL_PASSWORD=replace-with-staging-smtp-password
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=no-reply@staging.example.com
MAIL_FROM_NAME="Court Hub Staging"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
