APP_NAME="Court Hub API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=replace-with-production-db-host
DB_PORT=3306
DB_DATABASE=court_hub
DB_USERNAME=replace-with-production-db-user
DB_PASSWORD=replace-with-production-db-password

SESSION_DRIVER=database
SESSION_ENCRYPT=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=s3

REDIS_HOST=replace-with-production-redis-host
REDIS_PASSWORD=replace-with-production-redis-password
REDIS_PORT=6379

XENDIT_MOCK_ENABLED=false
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_RETURN_URL=https://app.example.com/payments/return

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=/secure/court-hub/fcm-service-account.json

MAIL_MAILER=smtp
MAIL_HOST=replace-with-production-smtp-host
MAIL_PORT=587
MAIL_USERNAME=replace-with-production-smtp-user
MAIL_PASSWORD=replace-with-production-smtp-password
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Court Hub"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
